.picker-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000; background: rgba(23, 37, 29, 0.55); }
.picker-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1001; height: 86vh; display: flex; flex-direction: column; overflow: hidden; box-sizing: border-box; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 24rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); }
.picker-sheet.typing { top: 0; height: auto; border-radius: 0; }
.picker-head { flex: none; background: #fff; }
.picker-title-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 72rpx; }
.picker-sheet .picker-title { flex: 1; min-width: 0; margin: 0; max-width: none; overflow-wrap: anywhere; }
.picker-sheet .picker-close { flex: none; width: auto; margin: 0; padding: 12rpx 8rpx 12rpx 24rpx; background: transparent; color: #18784e; font-size: 27rpx; font-weight: 600; line-height: 1.6; }
.picker-tabs { display: flex; gap: 12rpx; margin: 8rpx 0 16rpx; }
.picker-sheet .picker-tab { flex: 1; min-width: 0; width: auto; margin: 0; padding: 14rpx 6rpx; border-radius: 14rpx; background: #f4f6f5; color: #52645a; font-size: 25rpx; font-weight: 600; line-height: 1.5; white-space: nowrap; }
.picker-sheet .picker-tab.selected { background: #18784e; color: #fff; }
.picker-search { display: flex; align-items: center; gap: 16rpx; }
.picker-search .field { margin: 0 0 12rpx; }
.picker-sheet.typing .picker-tabs { display: none; }
.picker-scroll { flex: 1 1 auto; min-height: 0; background: #fff; }
.picker-row { display: flex; align-items: center; gap: 8rpx; padding: 20rpx 8rpx; border-bottom: 1rpx solid #edf1ee; }
.picker-row.picked { background: #eaf5ee; }
.picker-row .grow { min-width: 0; overflow-wrap: anywhere; }
.picker-sheet .picker-more { flex: none; width: auto; margin: 0; padding: 8rpx 12rpx; background: transparent; color: #18784e; font-size: 23rpx; font-weight: 400; line-height: 1.8; white-space: nowrap; }
.picker-empty { padding: 24rpx 0; }
.picker-sheet .picker-create-toggle { display: inline-block; width: auto; margin: 8rpx 0; padding: 12rpx 4rpx; background: transparent; color: #18784e; font-size: 26rpx; font-weight: 600; line-height: 1.6; }
.picker-create { padding: 8rpx 0 32rpx; }
.picker-sheet .picker-save { display: block; width: 100%; box-sizing: border-box; margin: 8rpx 0 0; padding: 22rpx; border-radius: 16rpx; background: #edf5ef; color: #18784e; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.picker-foot { flex: none; padding-top: 16rpx; background: #fff; border-top: 1rpx solid #edf1ee; }
.picker-sheet .picker-confirm { display: block; width: 100%; box-sizing: border-box; margin: 0; padding: 22rpx; border-radius: 16rpx; background: #18784e; color: #fff; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
