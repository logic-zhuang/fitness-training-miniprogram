.body-panel { background: #fff; border-radius: 28rpx; padding: 32rpx; margin-bottom: 24rpx; color: #17251d; }
.title { font-size: 31rpx; font-weight: 600; }
.map-wrap { width: 100%; max-width: 640rpx; margin: 16rpx auto 0; }
/* 与 SVG viewBox 420×440 同比例，image 用 scaleToFill 不会变形。 */
.map-stage { position: relative; width: 100%; height: 0; padding-top: 104.76%; }
.map-layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.map-views { display: flex; font-size: 24rpx; color: #52645a; }
.map-views text { flex: 1; text-align: center; }
.legend { display: flex; flex-wrap: wrap; margin: 20rpx 0 8rpx; font-size: 24rpx; color: #52645a; }
.legend-item { display: flex; align-items: center; margin: 0 28rpx 8rpx 0; }
.swatch { flex: none; width: 24rpx; height: 24rpx; border-radius: 6rpx; margin-right: 10rpx; }
.level-0 { background: #e3e7e5; border: 1rpx solid #a9b3ae; box-sizing: border-box; }
.level-1 { background: #f08a80; }
.level-2 { background: #c9302a; }
.categories { font-size: 26rpx; color: #52645a; margin: 12rpx 0 4rpx; line-height: 1.6; }
.row { display: flex; justify-content: space-between; align-items: center; min-height: 72rpx; font-size: 28rpx; border-bottom: 1rpx solid #edf1ee; }
.row-name { display: flex; align-items: center; min-width: 0; }
.row-sets { flex: none; margin-left: 16rpx; color: #52645a; }
.row-selected { background: #fdf1f0; }
.detail, .unknown { background: #f4f6f5; border-radius: 16rpx; padding: 16rpx 20rpx; margin-top: 12rpx; font-size: 26rpx; line-height: 1.7; }
.detail-title { font-weight: 600; }
.empty { font-size: 26rpx; color: #52645a; margin-top: 12rpx; }
.caption { font-size: 23rpx; color: #617369; line-height: 1.6; margin-top: 16rpx; }
