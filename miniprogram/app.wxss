page {
  background: #f4f7f5;
  color: #20352b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}
.page { padding: 36rpx 32rpx 60rpx; }
.heading { font-size: 40rpx; font-weight: 600; line-height: 1.4; margin: 14rpx 0 24rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin: 28rpx 0 18rpx; }
.between { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.grow { flex: 1; min-width: 0; }
.save-status { color: #18784e; font-size: 23rpx; line-height: 1.6; margin-bottom: 24rpx; }
.save-status.warning, .error { color: #a33c32; }
.status-detail { display: block; color: #a33c32; margin-top: 8rpx; }
.text-button { display: inline-block; background: transparent; color: #18784e; font-size: 25rpx; padding: 6rpx 10rpx; margin: 0; line-height: 1.8; }
.danger { color: #a33c32; }
.metric { font-size: 58rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.metric-caption { color: #68766e; font-size: 23rpx; margin-top: 6rpx; }
.stats { display: flex; gap: 40rpx; padding: 12rpx 0; }
.progress { height: 10rpx; background: #d7e8dc; border-radius: 8rpx; margin-top: 24rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #18784e; }
.tag { background: #edf5ef; color: #18784e; border-radius: 12rpx; padding: 8rpx 16rpx; font-size: 23rpx; display: inline-block; margin: 6rpx 10rpx 8rpx 0; }
.field { background: #f4f7f5; border: 1rpx solid #dce5df; border-radius: 14rpx; padding: 18rpx 20rpx; min-height: 48rpx; font-size: 28rpx; box-sizing: border-box; margin: 10rpx 0 22rpx; }
input.field { height: 84rpx; }
.label { color: #52645a; font-size: 25rpx; }
.small { font-size: 23rpx; }
.actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.actions .action { flex: 1; margin: 0; }
.divider { border-top: 1rpx solid #dce5df; margin: 20rpx 0; }
.exercise-line { padding: 18rpx 0; border-bottom: 1rpx solid #edf1ee; }
.exercise-line:last-child { border-bottom: 0; }
.month { color: #52645a; font-size: 27rpx; font-weight: 600; margin: 30rpx 0 18rpx; }
.record-preview { color: #52645a; line-height: 1.9; font-size: 25rpx; margin-top: 16rpx; }
.note { color: #52645a; background: #f4f7f5; border-radius: 12rpx; padding: 16rpx; margin-top: 18rpx; font-size: 25rpx; line-height: 1.7; white-space: pre-wrap; }
.pills { white-space: nowrap; margin: 22rpx 0; }
.pill { display: inline-block; padding: 16rpx 22rpx; border-radius: 16rpx; margin-right: 12rpx; color: #52645a; background: #fff; }
.pill.active { color: #fff; background: #18784e; }
.set-grid { display: grid; grid-template-columns: 34rpx minmax(0, 1fr) minmax(0, 1fr) 76rpx 38rpx; gap: 10rpx; align-items: center; margin: 18rpx 0; }
.set-grid input { min-width: 0; width: 100%; height: 80rpx; background: #f4f7f5; border-radius: 12rpx; text-align: center; box-sizing: border-box; }
.set-grid.done input { background: #eaf5ee; }
.set-grid button { min-width: 0; width: 100%; box-sizing: border-box; margin: 0; padding: 10rpx 0; font-size: 23rpx; line-height: 1.8; border-radius: 12rpx; }
.check { background: #eaf5ee; color: #18784e; }
.check.checked { background: #18784e; color: #fff; }
.remove { background: transparent; color: #a33c32; }
.rest-panel { position: sticky; top: 0; z-index: 10; background: #e5f2e9; border: 1rpx solid #b7d8c2; box-shadow: 0 6rpx 16rpx #20352b0d; }
.rest-clock { font-size: 44rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.rest-actions { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.rest-actions button { flex: 1; min-width: 0; white-space: nowrap; background: #fff; color: #18784e; font-size: 25rpx; padding: 10rpx 12rpx; margin: 0; line-height: 1.7; }
.workout-page { padding-bottom: 80rpx; }
.bottom-actions { margin-top: 36rpx; }
.auth-note { font-size: 24rpx; color: #68766e; line-height: 1.7; margin-top: 16rpx; }
.preview { color: #68766e; font-size: 23rpx; line-height: 1.8; margin-bottom: 36rpx; }
.eyebrow { color: #18784e; font-size: 24rpx; letter-spacing: 3rpx; margin-bottom: 18rpx; }
.title { font-size: 46rpx; font-weight: 600; line-height: 1.45; margin-bottom: 18rpx; }
.subtitle { color: #68766e; font-size: 27rpx; line-height: 1.8; margin-bottom: 34rpx; }
.panel { background: #ffffff; border-radius: 28rpx; padding: 32rpx; margin-bottom: 24rpx; }
.panel-title { font-size: 31rpx; font-weight: 600; margin-bottom: 18rpx; }
.muted { color: #68766e; font-size: 25rpx; line-height: 1.8; }
.accent-panel { background: #e5f2e9; }
.action { display: block; width: 100%; box-sizing: border-box; background: #18784e; color: #ffffff; text-align: center; border-radius: 16rpx; padding: 24rpx; margin-top: 26rpx; font-size: 28rpx; line-height: 1.5; }
.secondary { background: #edf5ef; color: #18784e; }
button::after { border: 0; }
.sheet-mask { position: fixed; inset: 0; z-index: 70; background: rgba(15,30,20,.4); display: flex; align-items: flex-end; }
.sheet-panel { width: 100%; box-sizing: border-box; max-height: 90vh; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 30rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); }
.sheet-panel .panel-title { margin: 0; max-width: 80%; overflow-wrap: anywhere; }
.sheet-body { height: 58vh; margin-top: 22rpx; }
.sheet-label { margin-top: 24rpx; }
.sheet-cancel { display: block; width: 100%; margin-top: 12rpx; text-align: center; }
.sheet-action { display: block; width: 100%; box-sizing: border-box; text-align: left; background: #fff; border-bottom: 1rpx solid #edf1ee; padding: 22rpx 0; margin: 0; font-size: 28rpx; line-height: 1.6; color: #20352b; }
.sheet-action .muted { display: block; font-size: 23rpx; }
.sheet-action.danger { color: #a33c32; }
.sheet-group { margin: 20rpx 0 4rpx; }
.week-change { margin-top: 18rpx; padding-top: 14rpx; border-top: 1rpx solid #dce5df; }
.row { display: flex; align-items: center; }
.number { color: #18784e; font-size: 32rpx; font-weight: 600; margin-right: 26rpx; }
.day-title { font-size: 29rpx; font-weight: 600; margin-bottom: 12rpx; }
.empty { text-align: center; padding: 50rpx 20rpx; }
.goal { box-sizing: border-box; width: 100%; min-height: 180rpx; padding: 24rpx; background: #f4f7f5; border-radius: 16rpx; font-size: 28rpx; line-height: 1.7; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 18rpx; margin-right: 24rpx; }

.backfill-row { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 18rpx; border: 1rpx solid #dce5df; border-radius: 14rpx; margin-bottom: 14rpx; background: #fbfdfc; }
