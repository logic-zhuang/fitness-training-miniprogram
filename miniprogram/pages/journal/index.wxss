.journal-page{padding-bottom:80rpx}.journal-filters{display:flex;gap:14rpx;margin:24rpx 0}.filter{background:#fff;color:#68766e;padding:14rpx 34rpx;border-radius:32rpx;margin:0;font-size:26rpx;line-height:1.5}.filter.active{background:#18784e;color:#fff}.day-header{display:flex;flex-wrap:wrap;align-items:center;gap:10rpx;margin-bottom:12rpx}.day-header .panel-title{margin:0}.tag{overflow-wrap:break-word;max-width:100%;box-sizing:border-box}.record-name{min-width:0;overflow-wrap:break-word;font-size:29rpx}.photos{display:grid;gap:12rpx;margin-top:20rpx;align-items:start}.photos-one{grid-template-columns:1fr}.photos-two{grid-template-columns:repeat(2,minmax(0,1fr))}.photos-three{grid-template-columns:repeat(3,minmax(0,1fr))}.photo-item{min-width:0}.photo{display:block;width:100%;height:190rpx;background:#edf3ef;border-radius:16rpx}.photos-one .photo{height:420rpx}.photos-two .photo{height:208rpx}.photo-caption{gap:4rpx}.photo-more{padding:0 8rpx;margin:0;background:transparent;color:#18784e;font-size:32rpx;line-height:1.7}.date-link{display:block;margin-top:18rpx}.photo-edit-mask{position:fixed;inset:0;z-index:80;background:rgba(15,30,20,.4);display:flex;align-items:center;padding:28rpx;overflow:auto}.photo-edit-panel{width:100%;box-sizing:border-box;max-height:85vh;overflow:auto}.photo-edit-panel .text-button{display:block;margin:18rpx auto 0}

.compare-section{margin-top:20rpx}.compare-section .section-title{margin-bottom:10rpx}
.compare-scroll{width:100%}.compare-row{display:flex;gap:12rpx;padding-bottom:6rpx}
.compare-card{min-width:200rpx;width:200rpx;background:#fff;border-radius:14rpx;padding:8rpx;box-shadow:0 1rpx 4rpx rgba(20,50,35,.06);box-sizing:border-box}
.compare-photo{height:200rpx;border-radius:10rpx}
.compare-card .muted{margin-top:6rpx;overflow-wrap:anywhere}
