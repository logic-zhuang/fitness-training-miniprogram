.plan-page{padding-top:20rpx;padding-bottom:300rpx}
.plan-page .action{width:100%;margin-left:0;margin-right:0;font-weight:600}
.plan-page .text-button{width:auto;margin-left:0;margin-right:0;padding-left:4rpx;padding-right:4rpx;font-weight:600}
.plan-heading{margin:4rpx 0 16rpx}
.plan-name-row{display:flex;align-items:center;gap:20rpx;background:#fff;border-radius:24rpx;padding:12rpx 20rpx 12rpx 24rpx;margin-bottom:20rpx}
.plan-name-row .label{flex:none}
.plan-name-row .plan-name{flex:1;min-width:0;margin:0}
.board-hint{color:#52645a;font-size:23rpx;line-height:1.6;margin:0 4rpx 16rpx}
.week-board{position:relative}
.week-slot{display:flex;align-items:stretch;gap:14rpx;padding:5rpx;margin-bottom:8rpx;border-radius:22rpx;scroll-margin-top:30rpx;transition:background-color .15s}
.slot-day{flex:none;width:76rpx;display:flex;align-items:center;justify-content:center;color:#17251d;font-size:26rpx;font-weight:600}
.day-card,.rest-card{flex:1;min-width:0;min-height:92rpx;box-sizing:border-box;display:flex;align-items:center;gap:12rpx;padding:12rpx 20rpx;border-radius:18rpx;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
.day-card{position:relative;z-index:1;background:#fff;border:2rpx solid #dce5df;box-shadow:0 2rpx 6rpx rgba(23,37,29,.05)}
.rest-card{border:2rpx dashed #cfdad3;color:#68766e}
.card-main{flex:1;min-width:0}
.card-title{color:#17251d;font-size:28rpx;font-weight:600;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card-meta{color:#52645a;font-size:23rpx;line-height:1.5;margin-top:2rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rest-label{flex:1;min-width:0;font-size:26rpx}
.card-side{flex:none;display:flex;align-items:center}
.card-edit{color:#18784e;font-size:24rpx;font-weight:600;white-space:nowrap}
.drop-badge{display:none;color:#fff;background:#18784e;border-radius:999rpx;padding:4rpx 16rpx;font-size:22rpx;font-weight:600;white-space:nowrap}
.day-card.lifted{z-index:40;border-color:#18784e;box-shadow:0 18rpx 40rpx rgba(23,37,29,.22)}
.week-slot.drag-source{background:#eef2ef}
.week-slot.drag-source .slot-day{color:#18784e}
.week-slot.drop-target{background:#eaf5ee;box-shadow:inset 0 0 0 2rpx #18784e}
.week-slot.drop-target .slot-day{color:#18784e}
.week-slot.drop-target .rest-card{border-color:#18784e;color:#18784e}
.week-slot.drop-target .card-edit{display:none}
.week-slot.drop-target .drop-badge{display:inline-block}
.week-board.dragging .day-card .card-edit{opacity:.4}
.week-slot.landed .day-card,.week-slot.landed .rest-card{animation:slot-land .45s ease-out}
@keyframes slot-land{0%{transform:scale(.96);background-color:#eaf5ee}100%{transform:scale(1)}}
.fixed-plan-footer{position:fixed;bottom:0;left:0;right:0;padding:12rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e4eae6;z-index:20}
.fixed-plan-footer .action{margin:8rpx 0}
.footer-note{color:#18784e;font-size:23rpx;line-height:1.6;text-align:center}
