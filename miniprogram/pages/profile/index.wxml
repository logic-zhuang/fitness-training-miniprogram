<import src="../../templates/status.wxml"/>
<view class="page"><template is="save-status" data="{{status,phase,error}}"/><view class="heading">我的</view>
<view class="panel row"><image class="avatar" src="/assets/training-avatar.png" mode="aspectFit"/><view><view class="panel-title">{{account ? (account.user.full_name || account.user.email || '微信用户') : '我的训练手记'}}</view><view class="muted">{{account ? '训练与照片保存在自己的账号' : '可先本机记录，登录后同步'}}</view></view></view>
<view class="panel" wx:if="{{!account}}"><button class="action" bindtap="loginWechat" loading="{{signingIn}}" disabled="{{signingIn}}">微信登录，同步训练记录</button><button class="text-button" bindtap="showBinding">绑定已有网站账号</button><view wx:if="{{binding}}"><input class="field" placeholder="已有账号邮箱" value="{{email}}" data-field="email" bindinput="field"/><input class="field" password="true" placeholder="密码" value="{{password}}" data-field="password" bindinput="field"/><button class="action secondary" bindtap="login" disabled="{{signingIn}}">验证账号并绑定微信</button></view></view>
<view class="error" wx:if="{{loginError}}">{{loginError}}</view>
<view class="panel"><button class="text-button" bindtap="openJournal">训练日志与照片 →</button><view class="muted small">按日期和训练部位查看每一次记录</view></view>
<view class="panel" wx:if="{{ready}}"><button class="text-button" bindtap="openLibrary">我的动作 →</button><view class="muted small">管理自建动作、收藏和最近使用的动作</view></view>
<view class="panel" wx:if="{{account && (loginRequired || binding)}}"><view class="panel-title">{{loginRequired ? '重新验证登录' : '网站账号已验证，继续绑定微信'}}</view><view class="muted small">本机记录保留。微信需要关联当前账号。</view><button class="action secondary" wx:if="{{loginRequired}}" bindtap="loginWechat" loading="{{signingIn}}" disabled="{{signingIn}}">重新微信登录</button><button class="action secondary" wx:elif="{{binding}}" bindtap="retryBinding" loading="{{signingIn}}" disabled="{{signingIn}}">重试绑定微信</button><button class="text-button" bindtap="showBinding">{{binding ? '收起邮箱验证' : '通过已有账号邮箱验证'}}</button><view wx:if="{{binding}}"><input class="field" placeholder="当前账号邮箱" value="{{email}}" data-field="email" bindinput="field"/><input class="field" password="true" placeholder="密码" value="{{password}}" data-field="password" bindinput="field"/><button class="action secondary" bindtap="login" disabled="{{signingIn}}">验证当前账号并绑定微信</button></view></view>
<view class="panel" wx:if="{{ready}}"><view class="panel-title">我的目标</view><textarea class="goal" value="{{goal}}" bindinput="onGoalInput" maxlength="2000"/><button class="text-button" bindtap="saveGoal" disabled="{{saving}}">保存目标</button></view>
<view class="panel"><view class="panel-title">数据与账号</view><button class="text-button" bindtap="sharePlan">分享我的训练计划</button><button class="text-button" bindtap="importPlanFromClipboard">粘贴导入好友计划</button><button class="text-button" bindtap="exportBackup">导出记录备份</button><button class="text-button" wx:if="{{account}}" bindtap="offerImport">导入本机训练记录</button><button class="text-button" wx:if="{{account && !loginRequired && !binding}}" bindtap="retryBinding" disabled="{{signingIn}}">关联当前账号与微信</button><button class="text-button" wx:if="{{account && phase === 'conflict'}}" bindtap="reloadCloud">备份后读取云端版本</button><button class="text-button" wx:if="{{account}}" bindtap="logout">退出账号</button></view></view>
<exercise-picker open="{{libraryOpen}}" managing="{{true}}" bindclose="closeLibrary"/>
